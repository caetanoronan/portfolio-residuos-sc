# Exemplo de arquivo .env para configuração da API
# Copie este arquivo para .env e ajuste os valores

# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================

# Ambiente: development, production
ENVIRONMENT=development

# ============================================
# AUTENTICAÇÃO (OPCIONAL)
# ============================================

# Habilitar autenticação com API Keys
# Valores: true ou false
# Padrão: false (API pública)
API_KEYS_ENABLED=false

# API Keys válidas (separadas por vírgula)
# Exemplo: API_KEYS=chave-secreta-1,chave-secreta-2,chave-secreta-3
# Deixe vazio se API_KEYS_ENABLED=false
API_KEYS=

# ============================================
# CACHE E PERFORMANCE
# ============================================

# Habilitar cache em memória (lru_cache)
CACHE_ENABLED=true

# Tempo de vida do cache em segundos (não usado atualmente com lru_cache)
CACHE_TTL_SECONDS=3600

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================

# Origens permitidas (separadas por vírgula)
# Use "*" para permitir todas as origens
# Exemplo: ALLOWED_ORIGINS=https://meuapp.com,https://dashboard.exemplo.com
ALLOWED_ORIGINS=*

# ============================================
# LIMITES E THROTTLING
# ============================================

# Limite de requisições por minuto (não implementado ainda)
# RATE_LIMIT_PER_MINUTE=60

# Tamanho máximo de resposta em registros
# MAX_RESULTS_PER_REQUEST=1000

# ============================================
# MONITORAMENTO
# ============================================

# URL do UptimeRobot ou outro serviço de monitoramento
# MONITORING_URL=https://uptimerobot.com

# ============================================
# DEPLOY (Render.com, Railway, Fly.io)
# ============================================

# Porta da aplicação (será sobrescrita por $PORT no deploy)
# PORT=8000

# Número de workers Uvicorn (produção)
# WEB_CONCURRENCY=2

# ============================================
# LOGS
# ============================================

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# EXEMPLOS DE CONFIGURAÇÃO POR AMBIENTE
# ============================================

# --- DESENVOLVIMENTO (API pública) ---
# API_KEYS_ENABLED=false
# ENVIRONMENT=development
# LOG_LEVEL=DEBUG

# --- PRODUÇÃO (API protegida) ---
# API_KEYS_ENABLED=true
# API_KEYS=prod-key-123abc,mobile-app-456def
# ENVIRONMENT=production
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=https://residuos-sc.github.io,https://dashboard.municipio.sc.gov.br

# --- TESTE (API protegida com chave conhecida) ---
# API_KEYS_ENABLED=true
# API_KEYS=test-key-123
# ENVIRONMENT=testing
# LOG_LEVEL=DEBUG
